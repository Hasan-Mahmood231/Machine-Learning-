														{
															"type": "bold"
														}
													],
													"text": "Definition:"
												},
												{
													"type": "text",
													"text": " The model learns the "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "training data"
												},
												{
													"type": "text",
													"text": " (including its noise and irrelevant"
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": " details) "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "too well"
												},
												{
													"type": "text",
													"text": ". It memorizes the data instead of generalizing the underlying patterns."
												}
											]
										}
									]
								}
